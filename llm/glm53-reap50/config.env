# shellcheck shell=bash
# Defaults for the GLM-5.3-Flash REAP50 deployment helper.
#
# Every value is overrideable from the environment or from the command line.
# Nothing here names a cluster, user, partition or absolute path: WORK_ROOT is
# resolved from the calling project's slurmhelps config (site.work_root) by the
# scripts before this file is sourced.

# --- what to install -------------------------------------------------------
: "${ENGINE:=sglang}"                 # sglang | vllm | llamacpp
: "${VARIANT:=nvfp4}"                 # nvfp4 | fp8 | q4_k_s | q4_k_m | iq4_xs | iq3_m
: "${INSTALL_METHOD:=auto}"           # auto | container | venv | source
: "${MODEL_ROOT:=${WORK_ROOT:-$HOME}/models/glm53-reap50}"
: "${IMAGE_DIR:=${WORK_ROOT:-$HOME}/images}"
: "${VENV_DIR:=${WORK_ROOT:-$HOME}/venvs/glm53-reap50}"
: "${SRC_DIR:=${WORK_ROOT:-$HOME}/src}"
: "${BUILD_DIR:=${WORK_ROOT:-$HOME}/build}"
: "${RUN_DIR:=${WORK_ROOT:-$HOME}/runs/glm53-reap50}"

# --- checkpoints -----------------------------------------------------------
: "${HF_REPO_NVFP4:=patrickbdevaney/GLM-5.3-Flash-REAP50-NVFP4-v2}"
: "${HF_REPO_FP8:=patrickbdevaney/GLM-5.3-Flash-REAP50-FP8-v2}"
: "${HF_REPO_GGUF:=patrickbdevaney/GLM-5.3-Flash-REAP50-GGUF}"
: "${GGUF_QUANT:=Q4_K_S}"             # Q4_K_S (87.1 GiB) | Q4_K_M (92.5 GiB) | IQ4_XS (82.0 GiB) | IQ3_M (67.2 GiB)
: "${HF_TOKEN:=}"                     # optional; anonymous download is fine (MIT models)
: "${HF_TRANSFER:=1}"                 # use hf_transfer when available

# --- containers ------------------------------------------------------------
: "${SGLANG_IMAGE:=lmsysorg/sglang:glm-5.3-flash}"
: "${VLLM_IMAGE:=vllm/vllm-openai:glm53-flash}"
: "${SGLANG_SIF:=${IMAGE_DIR}/sglang-glm53.sif}"
: "${VLLM_SIF:=${IMAGE_DIR}/vllm-glm53.sif}"

# --- llama.cpp -------------------------------------------------------------
# The published GGUFs were built against this fork; upstream >= b11273 can also
# load them with three tokenizer/architecture overrides, but the fork is the
# zero-friction, validated path.
: "${LLAMACPP_REPO:=https://github.com/patrickbdevaney/llama.cpp}"
: "${LLAMACPP_REF:=glm5-next-reap50-gguf-v1}"
: "${LLAMACPP_SRC:=${SRC_DIR}/llama.cpp-glm53}"
: "${LLAMACPP_BUILD:=${BUILD_DIR}/llama.cpp-glm53}"
: "${LLAMA_SERVER:=${LLAMACPP_BUILD}/bin/llama-server}"
: "${CUDA_HOME:=/usr/local/cuda}"
: "${CUDA_ARCH:=native}"              # 70 (V100), 89 (L40), 120 (RTX PRO 6000 Blackwell)
: "${BUILD_JOBS:=16}"

# --- server shape ----------------------------------------------------------
: "${PORT:=30000}"                    # shared default; serve.sh accepts --port for vLLM/llama.cpp too
: "${HOST:=0.0.0.0}"
: "${SERVED_MODEL_NAME:=glm53-reap50}"
: "${TP:=2}"                          # tensor parallel; 1 for llama.cpp (layer split instead)
: "${DP:=1}"                          # data parallel replicas (SGLang router / vLLM -dp)
: "${MAX_LEN:=32768}"
: "${MAX_RUNNING:=96}"                # max concurrent sequences
: "${MAX_PREFILL:=16384}"             # max batched/prefill tokens
: "${CHUNKED_PREFILL:=8192}"
: "${KV_DTYPE:=fp8_e4m3}"             # Blackwell: fp8_e4m3; Hopper: bf16; llama.cpp uses -ctk/-ctv q8_0
: "${MEM_FRACTION:=0.80}"             # SGLang --mem-fraction-static
: "${GPU_MEM_UTIL:=0.90}"             # vLLM --gpu-memory-utilization
: "${CUDA_GRAPH_BS:=128}"             # SGLang --cuda-graph-max-bs-decode
: "${SCHEDULE_POLICY:=lpm}"           # lpm for shared prefixes; fcfs otherwise
: "${ENABLE_PREFIX_CACHE:=1}"
: "${ENABLE_METRICS:=1}"
: "${ENABLE_CACHE_REPORT:=1}"
: "${HEALTH_TIMEOUT_S:=1800}"

# llama.cpp slot/context shape. llama.cpp's -c is the TOTAL context shared by
# -np slots, so per-slot context is -c / -np. Keep CTX_TOTAL explicit.
: "${CTX_TOTAL:=262144}"              # 96 slots x ~2.7k tokens, or 32 slots x 8k
: "${LLAMA_BATCH:=4096}"
: "${LLAMA_UBATCH:=1024}"
: "${LLAMA_CACHE_REUSE:=256}"
: "${LLAMA_KV_TYPE:=q8_0}"
: "${LLAMA_MMAP:=0}"                  # 0 = --no-mmap (sequential NFS read; 82 GiB fits in RAM)

# --- benchmark -------------------------------------------------------------
: "${BENCH_CONCURRENCY:=1 2 4 8 16 32 64 96 128}"
: "${BENCH_ISL:=2048}"
: "${BENCH_OSL:=256}"
: "${BENCH_RUNS:=3}"
: "${BENCH_PROMPT_FACTOR:=5}"         # num_prompts >= factor * concurrency
: "${BENCH_MIN_PROMPTS:=200}"
: "${BENCH_MAX_PROMPTS:=4000}"
: "${BENCH_WARMUP_MAX:=256}"
: "${BENCH_SHARED_PREFIX:=0}"         # >0 measures prefix-cache reuse
: "${BENCH_CACHE_REGIME:=cold}"       # cold | warm-shared
: "${BENCH_SLO_TTFT_MS:=2000}"
: "${BENCH_SLO_TPOT_MS:=80}"
: "${BENCH_FLUSH_CACHE:=1}"
: "${BENCH_WORKERS:=1}"               # >1 for >3k tok/s aggregate (multiprocess client)
: "${BENCH_TIMEOUT_S:=600}"
: "${BENCH_SEED:=1}"
